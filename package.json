{
  "name": "bindery",
  "version": "0.1.0",
  "description": "Desktop app for merging audiobook chapter files into a single M4B with chapters, metadata, and cover art",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite dev",
