{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Bind it",
	"version": "1.0.0",
	"identifier": "audio.bindit.app",
	"build": {
		"beforeDevCommand": "vite dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "vite build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "",
				"width": 860,
				"height": 640,
				"minWidth": 580,
				"minHeight": 480,
				"dragDropEnabled": true,
				"focus": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": [
			"binaries/ffmpeg",
			"binaries/ffprobe"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}